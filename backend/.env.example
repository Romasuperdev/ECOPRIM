APP_NAME=ECOPRIM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de données : SQL Server ---
DB_CONNECTION=economat
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=ECONOMAT
DB_USERNAME=sa
DB_PASSWORD=

# Base de contrôle partagée (comptes RH_USER) — lecture seule, pour la connexion uniquement
DB_MASTER_DATABASE=dbmasterbacou

# Base pédagogique ECONOMAT — lecture seule (application principale)
DB_ECONOMAT_DATABASE=ECONOMAT

# Base propre ECOPRIM (écrivable) — gouvernance Console
DB_ECOPRIM_DATABASE=ecoprim

# Restreindre la connexion aux comptes RH_USER de cette application (colonne CodeApp).
# Laisser vide = aucune restriction par application.
ECOPRIM_CODE_APP=

# --- Sanctum (auth SPA) ---
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:5174,127.0.0.1:5174
SESSION_DRIVER=cookie
SESSION_DOMAIN=localhost

# --- Frontend --- (Vite bascule sur 5174 si 5173 est occupé, on autorise les deux en dev)
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:5174

CACHE_STORE=file
QUEUE_CONNECTION=sync
