# =============================================================================
#  NEXORA École Primaire — configuration de PRODUCTION
# =============================================================================
#
#  Copiez ce fichier en « .env » sur le serveur, puis remplacez chaque valeur
#  entre < >. Lancez ensuite :
#
#      php artisan key:generate
#      php artisan nexora:verifier-deploiement
#
#  La seconde commande contrôle tout ce qui suit et dit quoi corriger.
#
# =============================================================================

APP_NAME="NEXORA École Primaire"

# production ferme les tolérances de développement : les origines du réseau local
# ne sont plus admises d'office, ni par CORS ni par Sanctum.
APP_ENV=production

# false, sans discussion. Activé, une erreur expose le code, les requêtes SQL et
# des valeurs de configuration — mots de passe de base compris.
APP_DEBUG=false

# Générée par « php artisan key:generate ». Sans elle, aucune session.
APP_KEY=

# L'adresse publique du site, sans barre finale. Sert aux liens absolus des
# documents imprimés.
APP_URL=https://<domaine-de-l-ecole>

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# --- Base de données ---------------------------------------------------------
# Les trois connexions partagent le même serveur et le même compte. Ce compte doit
# LIRE ECONOMAT et dbmasterbacou, et ÉCRIRE dans ecoprim.
DB_CONNECTION=economat
DB_HOST=<serveur-sql>
DB_PORT=1433
DB_DATABASE=ecoprim
DB_USERNAME=<compte-sql>
DB_PASSWORD=<mot-de-passe>

DB_MASTER_DATABASE=dbmasterbacou
DB_ECONOMAT_DATABASE=ECONOMAT
DB_ECOPRIM_DATABASE=ecoprim

# Pensez à désactiver l'expiration du mot de passe sur ce compte :
#   ALTER LOGIN <compte-sql> WITH CHECK_EXPIRATION = OFF;
# Sans cela, tout s'arrête du jour au lendemain, sans prévenir.

# --- Sessions et authentification --------------------------------------------
SESSION_DRIVER=cookie

# LAISSER VIDE. Renseigné, Laravel pose le cookie avec ce domaine, et un navigateur
# ouvert sur un autre hôte le refuse : la connexion ne tient pas.
SESSION_DOMAIN=

# Le site est servi en HTTPS : le cookie ne doit voyager que chiffré.
SESSION_SECURE_COOKIE=true

# L'interface et l'API partagent la MÊME origine (Apache sert les deux) : il suffit
# donc d'y déclarer le domaine du site.
SANCTUM_STATEFUL_DOMAINS=<domaine-de-l-ecole>
FRONTEND_URL=https://<domaine-de-l-ecole>
FRONTEND_URLS=https://<domaine-de-l-ecole>

# --- Photos des élèves -------------------------------------------------------
# Dossier PARTAGÉ, lu aussi par ECONOMAT. Non renseigné, les photos restent dans le
# stockage de NEXORA et ECONOMAT ne les verra jamais.
# Guillemets SIMPLES si le chemin contient des antislashs, sinon dotenv refuse de
# démarrer :
#   NEXORA_PHOTOS_ELEVES='\\SERVEUR\ECONOMAT\Photos'
NEXORA_PHOTOS_ELEVES=

# 51200 Ko = 50 Mo. PHP tranche AVANT Laravel : upload_max_filesize et post_max_size
# du php.ini doivent être au moins aussi hauts, sinon ce sont eux qui font loi.
NEXORA_PHOTOS_TAILLE_MAX_KO=51200

# --- Divers ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=warning
CACHE_STORE=file
QUEUE_CONNECTION=sync
